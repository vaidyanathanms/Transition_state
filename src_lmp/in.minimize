# Initial equilibration using minimize and NPT
# Vaidyanathan Sethuraman - Nov-11-2026
# LAMMPS real units / OPLS 1-4 scaling.
units real
atom_style full
boundary p p p
pair_style lj/cut/coul/long 10.0
pair_modify mix geometric
bond_style harmonic
angle_style harmonic
dihedral_style opls
special_bonds lj/coul 0.0 0.0 0.5
read_data mixture.data
kspace_style pppm 1.0e-5

group water type 4 5
fix rigidwater water shake 1.0e-5 20 0 b 4 a 5

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo 100
thermo_style custom step temp pe etotal press density
# Verify initial structure with a minimization before MD.
min_style cg
minimize 1.0e-4 1.0e-6 2000 10000
write_data minimized.data

# Do NPT
dump main all custom 10000 config_shortnpt.lammpstrj id type xu yu zu
fix  momentum all momentum 100000 linear 1 1 1
fix  integrate all npt temp 300.0 300.0 100.0 iso 0.1 1.0 1000
timestep 1
run_style verlet
restart   500000  restart1 restart2
restart   1000000 archival_restarts/archival_*.restart
run 20000000

# Unfix and write output
unfix rigidwater
unfix momentum
unfix integrate
write_data      npt_out.data
write_restart 	restart.npt
